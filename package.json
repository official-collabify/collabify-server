{
  "name": "collabify-server",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "docker compose up -d && bun run --hot src/app/server.ts",
    "build": "bun build ./src/app/server.ts --outdir ./dist --target bun ",
    "turbo:build": "turbo run build",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "gen": "bun run scripts/generate-schema.ts && graphql-codegen && bun run scripts/sync-schema.ts",
    "sync": "bun run scripts/sync-schema.ts",
    "typecheck": "tsc --noEmit",
    "killall": "pkill -9 bun || true",
    "db:seed": "bun run prisma/seeds/index.ts",
    "db:seed:permissions": "bun run prisma/seeds/seed-permissions.ts",
    "db:seed:auth": "bun run prisma/seeds/seed-auth.ts",
    "db:repair": "bun run prisma/seeds/repair-role-permissions.ts",
    "db:flush-cache": "bun run scripts/db/flush-permission-cache.ts",
    "db:purge-ws-perms": "bun run scripts/db/purge-dead-workspace-role-permissions.ts",
    "db:migrate-perms": "bun run scripts/db/migrate-permissions.ts",
    "db:backfill:plugins": "bun run scripts/db/backfill-project-plugins.ts",
    "db:check-perms": "bun run scripts/db/check-workspace-perms.ts",
    "test": "bun test ./src",
    "test:watch": "bun test --watch ./src",
    "test:module": "bun test",
    "sync-permissions": "bun run scripts/sync-permissions.ts",
    "check-permissions": "bun run scripts/sync-permissions.ts --check",
    "reset-rbac": "bun run scripts/reset-rbac.ts",
    "reset-rbac:dry": "bun run scripts/reset-rbac.ts --dry-run",
    "clear-redis": "bun run scripts/clear-registry.ts",
    "check-migration-safety": "bun run scripts/check-migration-safety.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-ses": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@graphql-codegen/cli": "^6.1.2",
    "@hono/clerk-auth": "^3.1.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sendgrid/mail": "^8.1.6",
    "@types/pg": "^8.18.0",
    "bullmq": "^5.70.1",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "graphql": "^16.13.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.18.0",
    "hono": "^4.12.3",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.10.0",
    "nanoid": "3.3.4",
    "nodemailer": "^8.0.2",
    "pg": "^8.19.0",
    "pg-listen": "^1.7.0",
    "pino": "^10.3.1",
    "pnpm": "^10.30.3",
    "prom-client": "^15.1.3",
    "resend": "^6.9.4",
    "svix": "^1.86.0",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "vitest": "^4.1.5",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@graphql-codegen/typescript-resolvers": "^5.1.6",
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "@types/k6": "^1.6.0",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.4.0",
    "glob": "^13.0.6",
    "globals": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "turbo": "^2.9.6",
    "typescript-eslint": "^8.56.1"
  }
}

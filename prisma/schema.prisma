generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum RoleScopeType {
  WORKSPACE
  PROJECT
}

enum PrincipalType {
  USER
  ROLE
  ALL
}

// ─── Plugin Architecture ──────────────────────────────────────────────────────

enum PluginType {
  CHAT
  WHITEBOARD
  PAGES
  VAULT
  ISSUES
}

model User {
  id           String     @id @unique
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String?    @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)

  // ── Profile Fields ────────────────────────────────────────────────────────
  bio              String?  @db.Text
  timezone         String?  @default("UTC")
  language         String?  @default("en")

  // ── Billing Link ──────────────────────────────────────────────────────────
  stripeCustomerId String?  @unique @map("stripe_customer_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions         UserSession[]
  keys             UserKey[]
  workspaceMembers WorkspaceMember[]
  auditLogs        AuditLog[]

  projectMembers   ProjectMember[]
  resourcePolicies ResourcePolicy[]

  subscription Subscription?
  usageRecords UsageRecord[]

  assignedIssues   Issue[]           @relation("IssueAssignee")
  createdIssues    Issue[]           @relation("IssueCreator")
  chatMembers      ChatMember[]
  sentMessages     ChatMessage[]
  messageReactions MessageReaction[]
  meetParticipants MeetParticipant[]

  createdPages       Page[]              @relation("CreatedPages")
  lockedPages        Page[]              @relation("PageLockHolder")
  pageCollaborations PageCollaborator[]  @relation("PageCollaborations")
  uploadedFiles      VaultFile[]
  pinnedFolders      VaultPinnedFolder[]

  createdWhiteboards       Whiteboard[]             @relation("CreatedWhiteboards")
  whiteboardCollaborations WhiteboardCollaborator[] @relation("BoardCollaborators")

  notifications           Notification[]
  sentNotifications       Notification[]            @relation("NotificationActor")
  aiConversations         CollabifyAiConversation[]
  notificationPreferences             NotificationPreference[]
  conversationNotifPreferences        ConversationNotificationPreference[]

  @@index([email])
  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  deviceInfo String? @map("device_info")
  ipAddress  String? @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model UserKey {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  provider   String
  providerId String @map("provider_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("user_keys")
}

model Workspace {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  logoS3Key       String? @map("logo_s3_key")
  domainWhitelist String? @map("domain_whitelist")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  auditLogs AuditLog[]
  roles     Role[]
  projects  Project[]

  pages               Page[]
  vaultFiles          VaultFile[]
  vaultProjectUsage   VaultProjectUsage[]
  vaultWorkspaceUsage VaultWorkspaceUsage?
  whiteboards         Whiteboard[]
  chats               ChatConversation[]

  plugins                 WorkspacePlugin[]

  usageRecords            UsageRecord[]
  notificationPreferences NotificationPreference[]  
  notifications           Notification[]
  issues                  Issue[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  // Unified role FK — points to Role table (seeded via seed-auth-roles.ts)
  roleId String @map("role_id")

  joinedAt            DateTime  @default(now()) @map("joined_at")
  lastAccessedAt      DateTime  @default(now()) @map("last_accessed_at")
  lastActiveProjectId String?   @map("last_active_project_id")

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRole      Role      @relation("WorkspaceMemberRole", fields: [roleId], references: [id])
  lastActiveProject Project?  @relation("MemberLastActiveProject", fields: [lastActiveProjectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([userId, lastAccessedAt(sort: Desc)])
  @@index([roleId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  email       String
  token       String   @unique
  // FK to Role row — resolves which workspace role the invitee will receive on accept
  roleId    String   @map("role_id")
  inviterId String   @map("inviter_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedRole Role      @relation("WorkspaceInviteRole", fields: [roleId], references: [id])

  @@index([email])
  @@map("workspace_invites")
}

// ─── Authorization: Permission Registry ─────────────────────────────────────
// Replaces SystemPermission. Seeded from module PermissionDefinition manifests.
// hasConditions drives the two-tier Redis cache split (see auth-redis-cache.md).
model Permission {
  id            String  @id @default(cuid())
  resource      String // e.g. "issue", "vault.file", "page"
  action        String // e.g. "create", "delete", "share"
  description   String?
  module        String  @default("")
  hasConditions Boolean @default(false) @map("has_conditions")
  isDeprecated  Boolean @default(false) @map("is_deprecated")

  inRoles          RolePermission[]
  resourcePolicies ResourcePolicy[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

// ─── Authorization: Role ─────────────────────────────────────────────────────
// System roles (OWNER/ADMIN/MEMBER/GUEST + MANAGER/CONTRIBUTOR/VIEWER) seeded
// with isSystem=true. Custom roles created by admins.
//
// scopeType = WORKSPACE → assigned via WorkspaceMember.roleId
// scopeType = PROJECT   → assigned via ProjectMember.projectRoleId
//
// projectId = null  → workspace-wide role template (applies to all projects)
// projectId = set   → role specific to one project (never leaks to other projects)
model Role {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id") // always required — every role belongs to a workspace
  projectId   String?       @map("project_id")   // null = workspace-wide; set = project-specific
  name        String
  description String?
  scopeType   RoleScopeType @default(WORKSPACE) @map("scope_type")
  isSystem    Boolean       @default(false) @map("is_system")
  // Rank controls privilege escalation guard: users cannot grant/restrict roles >= their own rank
  rank        Int           @default(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation("ProjectScopedRoles", fields: [projectId], references: [id], onDelete: Cascade)

  permissions      RolePermission[]
  workspaceMembers WorkspaceMember[] @relation("WorkspaceMemberRole")
  projectMembers   ProjectMember[]   @relation("ProjectMemberRole")
  workspaceInvites WorkspaceInvite[] @relation("WorkspaceInviteRole")

  // name is unique per (workspace + project) scope
  // projectId=null means workspace-wide; projects share role name namespace per workspace
  @@unique([workspaceId, projectId, name])
  @@unique([id, workspaceId]) // compound FK anchor for ProjectMember cross-tenant guard
  @@index([workspaceId])
  @@index([projectId])
  @@map("roles")
}

model RolePermission {
  roleId       String       @map("role_id")
  permissionId String       @map("permission_id")
  effect       PolicyEffect @default(ALLOW)
  conditions   Json? // e.g. {"StringEquals": {"resource.createdBy": "${userId}"}}

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ResourcePolicy {
  id     String @id @default(cuid())
  userId String @map("user_id")

  resourceId   String @map("resource_id")
  resourceType String @map("resource_type")

  permissionId  String        @map("permission_id")
  effect        PolicyEffect
  principalType PrincipalType @default(USER) @map("principal_type")
  conditions    Json? // runtime attribute conditions

  createdAt DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId, permissionId])
  @@index([resourceId, resourceType])
  @@map("resource_policies")
}

model Project {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  key         String  @map("key")
  name        String
  description String?
  isPrivate   Boolean @default(true) @map("is_private")
  isArchived  Boolean @default(false) @map("is_archived")
  logoS3Key   String? @map("logo_s3_key")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  roles     Role[]           @relation("ProjectScopedRoles")

  plugins                  ProjectPlugin[]

  pages                    Page[]
  vaultFolders             VaultFolder[]
  vaultFiles               VaultFile[]
  vaultPinnedFolders       VaultPinnedFolder[]
  vaultProjectUsage        VaultProjectUsage[]
  whiteboards              Whiteboard[]
  chats                    ChatConversation[]
  issueStatuses            IssueStatus[]
  issues                   Issue[]
  issueLabels              IssueLabel[]
  notificationPreferences  NotificationPreference[]
  notifications            Notification[]
  projectCounters          ProjectCounter[]
  meets                    Meet[]
  collabifyAiConversations CollabifyAiConversation[]
  memberLastActiveRefs     WorkspaceMember[]         @relation("MemberLastActiveProject")

  @@unique([workspaceId, key])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectCounter {
  projectId   String @map("project_id")
  counterType String @map("counter_type")
  currentVal  Int    @default(0) @map("current_val")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, counterType])
  @@map("project_counters")
}

// Junction table: which plugins are active for a given project.
// All 5 plugins are seeded on project creation. Admins can toggle via ToggleProjectPlugin.
model ProjectPlugin {
  projectId String     @map("project_id")
  type      PluginType
  isSystem  Boolean    @default(false) @map("is_system")
  settings  Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@map("project_plugins")
}

// Junction table: which plugins are active at the workspace level (future use).
model WorkspacePlugin {
  workspaceId String     @map("workspace_id")
  type        PluginType
  isSystem    Boolean    @default(false) @map("is_system")
  settings    Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
  @@map("workspace_plugins")
}

model ProjectMember {
  id String @id @default(cuid())

  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  userId        String  @map("user_id")
  projectRoleId String? @map("project_role_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  projectRole Role? @relation("ProjectMemberRole", fields: [projectRoleId, workspaceId], references: [id, workspaceId])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum PageCollaboratorRole {
  EDITOR
  VIEWER
}

model Page {
  id           String  @id @default(cuid())
  workspaceId  String  @map("workspace_id")
  projectId    String  @map("project_id")
  parentPageId String? @map("parent_page_id")

  // ── Content ──────────────────────────────────────────────────────────────
  title         String  @default("Untitled")
  emojiIcon     String? @map("emoji_icon")
  coverImageUrl String? @map("cover_image_url")

  // ── Yjs Snapshot (mirrors Whiteboard) ────────────────────────────────────
  s3Key                String?   @map("s3_key")
  lastSnapshotStreamId String?   @map("last_snapshot_stream_id") @db.VarChar(50)
  lastSnapshotAt       DateTime? @map("last_snapshot_at")

  // ── State & Lifecycle ─────────────────────────────────────────────────────
  isLocked   Boolean @default(false) @map("is_locked")
  lockedBy   String? @map("locked_by")
  isArchived Boolean @default(false) @map("is_archived")

  // ── Ordering (fractional indexing for sidebar tree) ───────────────────────
  position Float @default(0) @map("position")

  // ── Ownership & Timestamps ───────────────────────────────────────────────
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ── Relations ────────────────────────────────────────────────────────────
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator    User      @relation("CreatedPages", fields: [createdBy], references: [id])
  lockHolder User?     @relation("PageLockHolder", fields: [lockedBy], references: [id], onDelete: SetNull)

  parentPage Page?  @relation("PageHierarchy", fields: [parentPageId], references: [id])
  childPages Page[] @relation("PageHierarchy")

  collaborators PageCollaborator[]

  @@index([projectId, position])
  @@index([projectId, parentPageId])
  @@index([createdBy])
  @@index([updatedAt(sort: Desc)])
  @@map("pages")
}

model PageCollaborator {
  id     String               @id @default(cuid())
  pageId String               @map("page_id")
  userId String               @map("user_id")
  role   PageCollaboratorRole @default(VIEWER) @map("role")

  joinedAt DateTime @default(now()) @map("joined_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation("PageCollaborations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
  @@map("page_collaborators")
}

// ─── Vault Enums ─────────────────────────────────────────────────────────────

enum VaultFileStatus {
  PENDING // Upload slot reserved — S3 PUT not yet confirmed
  ACTIVE // Confirmed and visible in Vault
  DELETED // Soft-deleted (S3 lifecycle handles object expiry)
}

enum VaultFileSource {
  VAULT // Uploaded directly from the Vault UI
  PAGE // Embedded in a Page
  CHAT // Attached to a chat message
  WHITEBOARD // Used on a Whiteboard canvas
  TASK // Attached to a Task
}

// ─── Vault Models ─────────────────────────────────────────────────────────────

model VaultFolder {
  id             String  @id @default(cuid())
  projectId      String  @map("project_id")
  parentFolderId String? @map("parent_folder_id")
  name           String

  // System folders (From Chat, From Pages, etc.) — cannot be renamed/moved/deleted by users
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentFolder VaultFolder?        @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  childFolders VaultFolder[]       @relation("FolderHierarchy")
  files        VaultFile[]
  pinnedBy     VaultPinnedFolder[]

  @@index([projectId, parentFolderId]) // getVaultChildren: primary navigation query
  @@index([projectId, isSystem]) // getVaultSidebar: system folder lookup
  @@unique([projectId, name]) // one folder per name per project (partial: only non-deleted enforced in migration)
  @@map("vault_folders")
}

model VaultFile {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  projectId      String  @map("project_id")
  folderId       String? @map("folder_id") // null = file lives at root / Home
  uploaderUserId String? @map("uploader_user_id")

  name      String
  mimeType  String @map("mime_type")
  // BigInt for safety — files can exceed Int range (~2 GB)
  sizeBytes BigInt @map("size_bytes")
  s3Key     String @map("s3_key")

  // Upload lifecycle
  status      VaultFileStatus @default(PENDING) @map("status")
  confirmedAt DateTime?       @map("confirmed_at")

  // Source tracking — which module originally uploaded this file
  source   VaultFileSource @default(VAULT) @map("source")
  sourceId String?         @map("source_id") // pageId | conversationId | boardId | taskId

  // Unreferenced tracking — set by the editor on save when a file is removed from content.
  // The cleanup job uses this to soft-delete files that are no longer in the saved document
  // after a grace period (default 30 min), giving in-session undo a safe recovery window.
  // All three fields are nullable: null = file is still actively referenced.
  unrefAt         DateTime?       @map("unref_at")          // when the editor first marked this file unreferenced
  unrefEntityId   String?         @map("unref_entity_id")   // the entityId whose save triggered the mark
  unrefEntityType VaultFileSource? @map("unref_entity_type") // PAGE or TASK

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    VaultFolder? @relation(fields: [folderId], references: [id])
  uploader  User?        @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)

  @@index([projectId, folderId, status]) // getVaultChildren: primary file listing (covers status filter)
  @@index([projectId, source]) // filter files by source (e.g. From Chat)
  @@index([status, createdAt]) // cleanup job: find orphaned PENDING files
  @@index([workspaceId, status]) // workspace-wide ACTIVE file count
  @@index([status, unrefAt]) // unreferenced-cleanup job: find ACTIVE files past grace period
  @@map("vault_files")
}

// Per-project vault storage tracking.
// One row per project — all uploads within the project accumulate here.
model VaultProjectUsage {
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")

  // Confirmed ACTIVE bytes
  usedBytes     BigInt @default(0) @map("used_bytes")
  // In-flight PENDING bytes (reserved slots — prevents TOCTOU race on concurrent uploads)
  reservedBytes BigInt @default(0) @map("reserved_bytes")
  fileCount     Int    @default(0) @map("file_count")

  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([workspaceId, projectId])
  @@map("vault_project_usage")
}

// Per-workspace vault storage tracking (workspace-wide rollup across all projects).
// One row per workspace — no projectId needed.
model VaultWorkspaceUsage {
  workspaceId String @unique @map("workspace_id")

  usedBytes     BigInt @default(0) @map("used_bytes")
  reservedBytes BigInt @default(0) @map("reserved_bytes")
  fileCount     Int    @default(0) @map("file_count")

  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("vault_workspace_usage")
}

// User-scoped sidebar pinned folders. Each user pins their own set of folders per project.
model VaultPinnedFolder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  folderId  String   @map("folder_id")
  pinnedAt  DateTime @default(now()) @map("pinned_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  VaultFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId]) // one pin per user per folder
  @@index([userId, projectId]) // getVaultSidebar: fast pinned-folder lookup
  @@map("vault_pinned_folders")
}

model Whiteboard {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  projectId   String? @map("project_id")
  title       String
  description String?

  // --- S3 Persistence (V4 Snapshot-Primary) ---
  // The Source of Truth is the .yjs binary in S3.
  s3Key                String    @default("") @map("s3_key")
  // Critical for V4: The Redis Stream ID marking the end of this snapshot.
  // Replaying from this ID forward ensures no missing updates.
  lastSnapshotStreamId String?   @map("last_snapshot_stream_id") @db.VarChar(50)
  lastSnapshotAt       DateTime? @map("last_snapshot_at")

  // --- Metadata for Performance ---
  // Allows the UI to show board info/size without loading the binary.
  elementCount  Int    @default(0) @map("element_count")
  fileSizeBytes BigInt @default(0) @map("file_size_bytes")

  // --- Vault Media Reference Scan ---
  // S3 key for the latest.yjs snapshot; written by the stream worker after each
  // snapshot rebuild. Used by the vault cleanup job to parse the Y.Doc and verify
  // whether a VaultFile is still referenced in yAssets before hard-deleting.
  snapshotS3Key String? @map("snapshot_s3_key")

  // --- State & Lifecycle ---
  isArchived Boolean @default(false) @map("is_archived")
  isLocked   Boolean @default(false) @map("is_locked")

  // --- Ownership & Timestamps ---
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // --- Relations ---
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator       User                     @relation("CreatedWhiteboards", fields: [createdBy], references: [id])
  collaborators WhiteboardCollaborator[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([createdBy])
  @@index([updatedAt(sort: Desc)])
  @@map("whiteboards")
}

model WhiteboardCollaborator {
  id           String   @id @default(cuid())
  whiteboardId String   @map("whiteboard_id")
  userId       String   @map("user_id")
  joinedAt     DateTime @default(now()) @map("joined_at")

  whiteboard Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  user       User       @relation("BoardCollaborators", fields: [userId], references: [id])

  @@unique([whiteboardId, userId])
  @@index([userId])
  @@map("whiteboard_collaborators")
}

// ─── Issues Enums ─────────────────────────────────────────────────────────────

// Priority ordering: URGENT (highest) → NO_PRIORITY (lowest).
// DB enum order drives the default Prisma sort direction (ascending = URGENT first).
enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NO_PRIORITY
}

// Two-phase S3 upload lifecycle for issue descriptions.
enum IssueDescriptionStatus {
  PENDING // Presigned PUT URL issued; client hasn't confirmed yet
  ACTIVE // Confirmed in S3 — this is the live description
  SUPERSEDED // Replaced by a newer save (kept for short recovery window)
}

// ─── Issues Models ─────────────────────────────────────────────────────────────

// A Kanban column. Statuses are project-scoped and user-managed.
// Six system statuses are seeded on project creation and cannot be deleted.
model IssueStatus {
  id        String @id @default(cuid())
  projectId String @map("project_id")

  // Display
  name  String
  color String  @default("#6B7280") // hex — used for column header pill
  icon  String? // icon key, e.g. "circle-dashed", "check-circle"

  // Ordering — fractional index allows O(1) column drag-reorder
  position Float

  // System statuses (Backlog, Todo, In Progress, In Review, Done, Canceled)
  // cannot be deleted. Name/color/icon are still editable.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, position]) // column ordering query
  @@index([projectId, isSystem]) // system-folder lookup
  @@map("issue_statuses")
}

// A project-scoped label tag. Users create these; they persist across all
// issues in the project and are reused via the IssueToLabel join table.
model IssueLabel {
  id        String @id @default(cuid())
  projectId String @map("project_id")

  name  String
  color String @default("#6B7280") // hex — used for the label pill

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueToLabel[]

  @@unique([projectId, name]) // label names unique per project (case-sensitive)
  @@index([projectId])
  @@map("issue_labels")
}

// A single issue card on the Kanban board.
model Issue {
  id          String @id @default(cuid())
  projectId   String @map("project_id")
  workspaceId String @map("workspace_id")

  // Human-readable sequential number per project (e.g., shown as PROJ-42).
  // Assigned atomically via SELECT MAX(number)+1 FOR UPDATE inside a transaction.
  number Int @map("number")

  title String

  // Description lives in S3 as BlockNote JSON.
  // Null = no description saved yet.
  // Updated only after a successful confirmIssueDescriptionUpload.
  descriptionS3Key String? @map("description_s3_key")

  // Status (Kanban column)
  statusId String @map("status_id")

  // Priority — enum order in DB drives sort: URGENT first, NO_PRIORITY last
  priority IssuePriority @default(NO_PRIORITY)

  // Fractional index for manual ordering within a column (secondary sort after priority)
  position Float @default(0.0)

  // Assignee — null means unassigned
  assigneeId String? @map("assignee_id")

  // Due date — stored, no automated actions in V1
  dueDate DateTime? @map("due_date")

  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status    IssueStatus @relation(fields: [statusId], references: [id])
  assignee  User?       @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User        @relation("IssueCreator", fields: [createdById], references: [id])

  labels           IssueToLabel[]
  descriptionFiles IssueDescriptionFile[]

  @@unique([projectId, number]) // issue number unique per project
  @@index([projectId, statusId, priority, position]) // primary board query (covers status + sort)
  @@index([projectId, assigneeId]) // filter by assignee
  @@index([projectId, dueDate]) // filter by due date
  @@map("issues")
}

// Many-to-many join: which labels are attached to which issue.
// Cascade on both sides so deleting an issue or label cleans up automatically.
model IssueToLabel {
  issueId    String   @map("issue_id")
  labelId    String   @map("label_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  issue Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label IssueLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_to_labels")
}

// Tracks each two-phase S3 description upload for an issue.
// One ACTIVE row at a time; previous uploads become SUPERSEDED.
// PENDING rows older than 1 hour are cleaned up by an S3 lifecycle rule.
model IssueDescriptionFile {
  id      String @id @default(cuid())
  issueId String @map("issue_id")

  s3Key  String                 @map("s3_key") // full S3 object key
  status IssueDescriptionStatus @default(PENDING)

  // Recorded after S3 HeadObject confirms the upload
  sizeBytes Int? @map("size_bytes")

  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, status]) // active description lookup per issue
  @@index([status, createdAt]) // cleanup job: find stale PENDING uploads
  @@map("issue_description_files")
}

enum ConversationType {
  CHANNEL
  DM
  GROUP_DM
  THREAD
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model OutboxMessage {
  id               BigInt           @id @default(autoincrement())
  messageId        String           @unique @map("message_id")
  conversationId   String           @map("conversation_id")
  conversationType ConversationType @default(CHANNEL) @map("conversation_type")
  payload          Json
  status           OutboxStatus     @default(PENDING)
  errorLog         Json?            @map("error_log")
  retryCount       Int              @default(0) @map("retry_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  processedAt      DateTime?        @map("processed_at")

  @@unique([conversationId, messageId]) // Validated Idempotency Constraint
  @@index([status, createdAt])
  @@map("chat_outbox_messages")
}

model MessageEditOutbox {
  id          String       @id @default(cuid())
  messageId   String       @map("message_id")
  content     String // New content (up to 4000 chars)
  editedBy    String       @map("edited_by")
  editedAt    DateTime     @map("edited_at")
  nonce       String // Client-provided UUID for idempotency
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  processedAt DateTime?    @map("processed_at")

  @@unique([messageId, nonce]) // Prevent duplicate edits with same nonce
  @@index([status, createdAt])
  @@map("message_edit_outbox")
}

model MessageDeleteOutbox {
  id          String       @id @default(cuid())
  messageId   String       @map("message_id")
  deletedBy   String       @map("deleted_by")
  deletedAt   DateTime     @map("deleted_at")
  nonce       String // Client-provided UUID
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  processedAt DateTime?    @map("processed_at")

  @@unique([messageId, nonce])
  @@index([status, createdAt])
  @@map("message_delete_outbox")
}

model ChatConversation {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  projectId    String?          @map("project_id")
  type         ConversationType @default(CHANNEL)
  // Deterministic dedup key for 1:1 and group DMs.
  // Format (1:1): "proj_{projectId}_{minUserId}_{maxUserId}"
  // NULL for channels and threads. @@unique eliminates race conditions lock-free.
  dmHash       String?          @unique @map("dm_hash")
  name         String?
  topic        String?
  isArchived   Boolean          @default(false) @map("is_archived")
  isPublic     Boolean          @default(true) @map("is_public")
  lastSequence Int              @default(0) @map("last_sequence")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")
  closedAt     DateTime?        @map("closed_at") // Thread-specific: when thread was closed

  // Thread-specific fields (nullable for non-threads)
  parentConversationId String? @map("parent_conversation_id")
  parentMessageId      String? @map("parent_message_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Thread relationships
  parentConversation ChatConversation?  @relation("ThreadParent", fields: [parentConversationId], references: [id], onDelete: Cascade)
  childThreads       ChatConversation[] @relation("ThreadParent")
  parentMessage      ChatMessage?       @relation("MessageThreads", fields: [parentMessageId], references: [id], onDelete: Cascade)

  members                         ChatMember[]
  messages                        ChatMessage[]
  conversationNotifPreferences    ConversationNotificationPreference[]

  @@unique([projectId, name])
  @@unique([parentMessageId])
  @@index([parentConversationId])
  @@map("chat_conversations")
}

model ChatMember {
  id             String @id @default(cuid())
  conversationId String @map("conversation_id")
  userId         String @map("user_id")

  // Read State
  lastReadMsgId      String?  @map("last_read_msg_id") // Blue Tick
  lastDeliveredMsgId String?  @map("last_delivered_msg_id") // Double Tick
  lastReadSeq        Int      @default(0) @map("last_read_seq") // Watermark sequence
  lastReadAt         DateTime @default(now()) @map("last_read_at")

  // Metadata
  joinedAt DateTime @default(now()) @map("joined_at")
  isMuted  Boolean  @default(false) @map("is_muted")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([lastReadSeq])
  @@map("chat_members")
}

model ChatMessage {
  id             String @id // ULID
  conversationId String @map("conversation_id")
  authorUserId   String @map("author_user_id")

  // Sequencing (The Hybrid Link)
  streamId String @map("stream_id")
  sequence Int

  // Threading
  parentMessageId String? @map("parent_message_id")
  replyCount      Int     @default(0) @map("reply_count")

  // Content
  content  Json // Rich Text / Blocks
  type     String @default("TEXT")
  metadata Json? // Attachments, embeds

  // Lifecycle
  isEdited  Boolean   @default(false) @map("is_edited")
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  conversation  ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author        User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parentMessage ChatMessage?      @relation("ThreadReplies", fields: [parentMessageId], references: [id])
  replies       ChatMessage[]     @relation("ThreadReplies")
  reactions     MessageReaction[]
  mentions      Mention[]         @relation("MessageMentions")

  // Thread conversations spawned from this message
  threads ChatConversation[] @relation("MessageThreads")

  @@unique([conversationId, streamId]) // STRICT ORDERING CONSTRAINT
  @@unique([conversationId, sequence]) // DUAL SEQUENCING CONSTRAINT
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([parentMessageId, createdAt(sort: Asc)])
  @@index([conversationId, deletedAt]) // mutation delta: deleted messages since lastOpenedAt
  @@index([conversationId, editedAt])  // mutation delta: edited messages since lastOpenedAt
  @@map("chat_messages")
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String @map("message_id")
  userId    String @map("user_id")
  emoji     String // The unicode char or shortcode

  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji]) // One reaction per type per user
  @@index([messageId, createdAt(sort: Desc)]) // Fast lookups per message
  @@index([userId, createdAt(sort: Desc)]) // Fast lookups per user
  @@map("message_reactions")
}

enum MeetStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Meet {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  title     String
  startTime DateTime   @map("start_time")
  status    MeetStatus @default(SCHEDULED)

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants MeetParticipant[]

  @@index([projectId])
  @@map("meets")
}

model MeetParticipant {
  id       String    @id @default(cuid())
  meetId   String    @map("meet_id")
  userId   String    @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  meet Meet @relation(fields: [meetId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meet_participants")
}

model CollabifyAiConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  messages CollabifyAiMessage[]

  @@map("collabify_ai_conversations")
}

model CollabifyAiMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  citationData   Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation CollabifyAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("collabify_ai_messages")
}

enum NotificationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model NotificationOutbox {
  id              BigInt             @id @default(autoincrement())
  eventType       String             @map("event_type")
  payload         Json
  status          NotificationStatus @default(PENDING)
  deduplicationId String?            @unique @map("deduplication_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  processedAt     DateTime?          @map("processed_at")
  errorLog        Json?              @map("error_log")

  @@index([status, createdAt])
  @@map("notification_outbox")
}

model NotificationPreference {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  workspaceId  String?   @map("workspace_id")
  projectId    String?   @map("project_id")
  categoryKey  String    @map("category_key")
  emailEnabled Boolean   @default(true)  @map("email_enabled")
  pushEnabled  Boolean   @default(true)  @map("push_enabled")
  inAppEnabled Boolean   @default(true)  @map("in_app_enabled")
  globalMode   String?   @default("ALL") @map("global_mode")
  muteUntil    DateTime?                 @map("mute_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, projectId, categoryKey], map: "unique_user_preference_scope")
  @@index([userId])
  @@map("notification_preferences")
}

model Notification {
  id              String  @id @default(cuid())
  recipientUserId String  @map("recipient_user_id")
  actorId         String? @map("actor_id")
  entityType      String  @map("entity_type")
  entityId        String  @map("entity_id")
  category        String  @default("general")

  data Json

  isRead     Boolean @default(false) @map("is_read")
  isArchived Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at")

  recipient User  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId String?
  project     Project?   @relation(fields: [projectId], references: [id])
  projectId   String?

  @@index([recipientUserId, isRead, createdAt(sort: Desc)])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum ConversationNotifMode {
  ALL_MESSAGES
  MENTIONS_ONLY
  NOTHING
}

// Conversation-level notification preference (most granular scope).
// Controls per-channel/DM notification mode and temporary mutes.
// Replaces the binary ChatMember.isMuted for richer control.
model ConversationNotificationPreference {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  conversationId String               @map("conversation_id")

  // Notification mode for this conversation
  mode           ConversationNotifMode @default(ALL_MESSAGES) @map("mode")

  // Temporary mute — null means mode is permanent.
  // After muteUntil passes, resolver treats as if muteUntil=null automatically.
  muteUntil      DateTime?            @map("mute_until")

  // Per-channel overrides at conversation scope (null = inherit from global/workspace/project)
  pushEnabled    Boolean?             @map("push_enabled")
  emailEnabled   Boolean?             @map("email_enabled")

  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId], map: "unique_conv_notif_pref")
  @@index([userId])
  @@map("conversation_notification_preferences")
}

model AuditLog {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  actorUserId    String? @map("actor_user_id")
  action         String
  targetResource String  @map("target_resource")
  metadata       Json?

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  // Normalized Limits
  limits        PlanLimit[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model PlanLimit {
  id     String @id @default(cuid())
  planId String @map("plan_id")

  resourceKey String @map("resource_key")
  limitValue  Int    @map("limit_value")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // INDEXING: Fast lookup for a specific checking a specific rule
  @@unique([planId, resourceKey])
  @@map("plan_limits")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  planId String @map("plan_id")
  status String @default("ACTIVE")

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  overrides SubscriptionOverride[]

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status, endDate]) // For cron jobs finding expiring subs
  @@map("subscriptions")
}

model SubscriptionOverride {
  id             String @id @default(cuid())
  subscriptionId String @map("subscription_id")
  resourceKey    String @map("resource_key")
  limitValue     Int    @map("limit_value")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, resourceKey])
  @@map("subscription_overrides")
}

model UsageRecord {
  id          String  @id @default(cuid())
  userId      String? @map("user_id")
  workspaceId String? @map("workspace_id")

  resourceKey String    @map("resource_key")
  currentVal  Int       @default(0) @map("current_val")
  resetAt     DateTime? @map("reset_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceKey])
  @@unique([workspaceId, resourceKey])
  @@map("usage_records")
}

// ─── Feature Flags ────────────────────────────────────────────────────────────

enum FlagContextType {
  GLOBAL
  WORKSPACE
  PROJECT
  USER
}

/// Global feature flag registry. Each row is a flag definition.
/// The `defaultEnabled` value is the fallback when no override exists.
model FeatureFlag {
  id             String  @id @default(cuid())
  key            String  @unique // e.g. "ai.summary", "vault.video-preview"
  defaultEnabled Boolean @default(false) @map("default_enabled")
  description    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

/// Per-context override for a feature flag.
/// Resolution order: USER > PROJECT > WORKSPACE > GLOBAL (defaultEnabled)
model FeatureFlagOverride {
  id          String          @id @default(cuid())
  flagId      String          @map("flag_id")
  contextType FlagContextType @map("context_type")
  // contextId: userId | projectId | workspaceId (null for GLOBAL override)
  contextId   String?         @map("context_id")
  enabled     Boolean

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, contextType, contextId])
  @@index([flagId])
  @@index([contextId])
  @@map("feature_flag_overrides")
}

// ─── Mention System ──────────────────────────────────────────────────────────────

enum MentionTier {
  TIER_1
  TIER_2
  TIER_3
}

enum MentionStatus {
  ACTIVE
  ORPHANED
  REMOVED
}

model Mention {
  id               String        @id @default(cuid())

  sourceEntityId   String        @map("source_entity_id")
  sourceEntityType String        @map("source_entity_type")

  targetEntityId   String        @map("target_entity_id")
  targetEntityType String        @map("target_entity_type")

  displayText      String        @map("display_text")
  sourceLocation   Json?        @map("source_location")

  tier             MentionTier   @default(TIER_2)
  status           MentionStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  createdById      String       @map("created_by_id")

  backlinks        Backlink[]
  message          ChatMessage?  @relation("MessageMentions", fields: [sourceEntityId], references: [id], onDelete: Cascade)

  @@index([sourceEntityId, status])
  @@index([targetEntityId, status])
  @@index([createdById])
  @@map("mentions")
}

model Backlink {
  id               String   @id @default(cuid())
  
  sourceEntityId   String   @map("source_entity_id")
  sourceEntityType String   @map("source_entity_type")
  
  targetEntityId   String   @map("target_entity_id")
  targetEntityType String   @map("target_entity_type")
  
  mentionId        String   @map("mention_id")
  mention          Mention  @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  
  context          String?  @db.VarChar(100)
  
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([sourceEntityId, targetEntityId])
  @@index([targetEntityId])
  @@index([sourceEntityId])
  @@map("backlinks")
}

model MentionEvent {
  id           String   @id @default(cuid())
  mentionId    String   @map("mention_id")
  eventType    String   @map("event_type")
  payload      Json
  actorId      String?  @map("actor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([mentionId])
  @@index([createdAt])
  @@map("mention_events")
}
